rules_version = '2';
service cloud.firestore {
    
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        request.auth.uid in familyDoc(familyId).data.member_uids;
    }

    function isFamilyOwner(familyId) {
      return isSignedIn() &&
        familyDoc(familyId).data.owner_uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);
    }

    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isSignedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.auth.uid in request.resource.data.member_uids;
      allow update, delete: if isFamilyOwner(familyId);

      match /pets/{petId} {
        allow read, create, update, delete: if isFamilyMember(familyId);
      }
    }

    match /invitations/{invitationId} {
      allow create: if isSignedIn() &&
        request.resource.data.invited_by_uid == request.auth.uid;

      allow read: if isSignedIn() && (
        resource.data.invited_by_uid == request.auth.uid ||
        (request.auth.token.email != null &&
          request.auth.token.email == resource.data.to_email_lower)
      );

      allow update: if isSignedIn() && (
        resource.data.invited_by_uid == request.auth.uid ||
        (request.auth.token.email != null &&
          request.auth.token.email == resource.data.to_email_lower)
      );

      allow delete: if isSignedIn() && resource.data.invited_by_uid == request.auth.uid;
    }
  }
}
